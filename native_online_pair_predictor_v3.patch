+class PairwiseRidgePredictor:
+    """Cross-target predictor: one open-source RidgeClassifier over object-target pairs.
+
+    Unlike independent output heads, this can rank a target that has never had a
+    positive queried example by transferring across public target descriptions.
+    No unqueried outcome appears in features or fitting.
+    """
+    def __init__(self, ids, object_text, targets, target_text):
+        self.n = len(ids)
+        self.m = len(targets)
+        vec = HashingVectorizer(n_features=PAIR_FEATURES, alternate_sign=False, norm='l2', ngram_range=(1, 2))
+        O = vec.transform([object_text[i] for i in ids]).toarray().astype(np.float32)
+        T = vec.transform([target_text[t] for t in targets]).toarray().astype(np.float32)
+        Oo = O[:, None, :]
+        Tt = T[None, :, :]
+        self.F = np.concatenate([
+            np.broadcast_to(Oo, (self.n, self.m, PAIR_FEATURES)),
+            np.broadcast_to(Tt, (self.n, self.m, PAIR_FEATURES)),
+            Oo * Tt,
+            np.abs(Oo - Tt),
+        ], axis=2).astype(np.float32, copy=False)
+        self.public_similarity = np.clip(O @ T.T, 0.0, 1.0)
+
+    def predict(self, obs, Yobs):
+        y = np.asarray(Yobs[obs], dtype=np.int8).reshape(-1)
+        if len(y) == 0 or np.all(y == y[0]):
+            # Public-text-only prior for the rare edge case of a single-class warm start.
+            base = 0.02 + 0.16 * self.public_similarity
+            return np.clip(base, 1e-4, 1.0 - 1e-4), int(np.sum(y)) if len(y) else 0
+        Xtr = self.F[obs].reshape(-1, self.F.shape[2])
+        clf = RidgeClassifier(alpha=RIDGE_ALPHA, class_weight='balanced')
+        clf.fit(Xtr, y)
+        score = clf.decision_function(self.F.reshape(-1, self.F.shape[2])).reshape(self.n, self.m)
+        score = np.clip(score, -12.0, 12.0)
+        P = 1.0 / (1.0 + np.exp(-score))
+        return np.clip(P, 1e-4, 1.0 - 1e-4), 0
 
 
